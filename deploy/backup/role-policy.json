{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyBackupPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "daily/",
            "daily/*",
            "protected/",
            "protected/*",
            "config/",
            "config/*"
          ]
        }
      }
    },
    {
      "Sid": "WriteEncryptedAndReadBack",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/daily/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/protected/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/config/*"
      ],
      "Condition": {
        "StringEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "ReadBackOnlyBackupObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/daily/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/protected/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/config/*"
      ]
    },
    {
      "Sid": "RotateDailyOnly",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/daily/*"
    },
    {
      "Sid": "NeverDeleteProtectedOrVersions",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/protected/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/config/*"
      ]
    },
    {
      "Sid": "NeverDeleteVersions",
      "Effect": "Deny",
      "Action": "s3:DeleteObjectVersion",
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/*"
    }
  ]
}
