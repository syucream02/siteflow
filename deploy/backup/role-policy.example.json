{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Sid":  "ListOnlyBackupPrefixes",
                          "Effect":  "Allow",
                          "Action":  "s3:ListBucket",
                          "Resource":  "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME",
                          "Condition":  {
                                            "StringLike":  {
                                                               "s3:prefix":  [
                                                                                 "daily/",
                                                                                 "daily/*",
                                                                                 "protected/",
                                                                                 "protected/*",
                                                                                 "config/",
                                                                                 "config/*"
                                                                             ]
                                                           }
                                        }
                      },
                      {
                          "Sid":  "WriteEncryptedAndReadBack",
                          "Effect":  "Allow",
                          "Action":  [
                                         "s3:PutObject"
                                     ],
                          "Resource":  [
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/daily/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/protected/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/config/*"
                                       ],
                          "Condition":  {
                                            "StringEquals":  {
                                                                 "s3:x-amz-server-side-encryption":  "AES256"
                                                             }
                                        }
                      },
                      {
                          "Sid":  "ReadBackOnlyBackupObjects",
                          "Effect":  "Allow",
                          "Action":  "s3:GetObject",
                          "Resource":  [
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/daily/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/protected/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/config/*"
                                       ]
                      },
                      {
                          "Sid":  "RotateDailyOnly",
                          "Effect":  "Allow",
                          "Action":  "s3:DeleteObject",
                          "Resource":  "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/daily/*"
                      },
                      {
                          "Sid":  "NeverDeleteProtectedOrVersions",
                          "Effect":  "Deny",
                          "Action":  "s3:DeleteObject",
                          "Resource":  [
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/protected/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/config/*"
                                       ]
                      },
                      {
                          "Sid":  "NeverDeleteVersions",
                          "Effect":  "Deny",
                          "Action":  "s3:DeleteObjectVersion",
                          "Resource":  "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/*"
                      }
                  ]
}
