{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "RequireExplicitSSES3",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "DenyBackupRoleDeletingProtected",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::173291123374:role/SiteFlow-EC2-SSM-Role"
      },
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/protected/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/config/*"
      ]
    },
    {
      "Sid": "DenyBackupRoleDeletingVersions",
      "Effect": "Deny",
      "Principal": {
        "AWS": "arn:aws:iam::173291123374:role/SiteFlow-EC2-SSM-Role"
      },
      "Action": "s3:DeleteObjectVersion",
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/*"
    }
  ]
}
