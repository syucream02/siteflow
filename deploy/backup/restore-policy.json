{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "daily/*",
            "protected/*",
            "config/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/daily/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/protected/*",
        "arn:aws:s3:::siteflow-db-backups-173291123374-ap-southeast-2/config/*"
      ]
    }
  ]
}
