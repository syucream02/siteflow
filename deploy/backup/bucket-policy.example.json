{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Sid":  "DenyInsecureTransport",
                          "Effect":  "Deny",
                          "Principal":  "*",
                          "Action":  "s3:*",
                          "Resource":  [
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/*"
                                       ],
                          "Condition":  {
                                            "Bool":  {
                                                         "aws:SecureTransport":  "false"
                                                     }
                                        }
                      },
                      {
                          "Sid":  "RequireExplicitSSES3",
                          "Effect":  "Deny",
                          "Principal":  "*",
                          "Action":  "s3:PutObject",
                          "Resource":  "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/*",
                          "Condition":  {
                                            "StringNotEquals":  {
                                                                    "s3:x-amz-server-side-encryption":  "AES256"
                                                                }
                                        }
                      },
                      {
                          "Sid":  "DenyBackupRoleDeletingProtected",
                          "Effect":  "Deny",
                          "Principal":  {
                                            "AWS":  "arn:aws:iam::REQUIRES_APPROVED_AWS_ACCOUNT_ID:role/SiteFlow-EC2-SSM-Role"
                                        },
                          "Action":  "s3:DeleteObject",
                          "Resource":  [
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/protected/*",
                                           "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/config/*"
                                       ]
                      },
                      {
                          "Sid":  "DenyBackupRoleDeletingVersions",
                          "Effect":  "Deny",
                          "Principal":  {
                                            "AWS":  "arn:aws:iam::REQUIRES_APPROVED_AWS_ACCOUNT_ID:role/SiteFlow-EC2-SSM-Role"
                                        },
                          "Action":  "s3:DeleteObjectVersion",
                          "Resource":  "arn:aws:s3:::REQUIRES_APPROVED_BACKUP_BUCKET_NAME/*"
                      }
                  ]
}
