{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/SiteFlowRelease",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "CONTROL#production",
            "STOP#*",
            "GRANT#*",
            "LEASE#*",
            "USED#*",
            "STATE#*",
            "FINAL#*",
            "ABORT#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/SiteFlowRelease",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "USED#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "pk",
            "manifestHash",
            "claimedAt"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/SiteFlowRelease",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "STATE#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "pk",
            "status"
          ]
        }
      }
    },
    {
      "Effect": "Deny",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/SiteFlowRelease",
      "Condition": {
        "ForAnyValue:StringLike": {
          "dynamodb:LeadingKeys": [
            "CONTROL#*",
            "STOP#*",
            "GRANT#*",
            "LEASE#*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Resource": "arn:aws:dynamodb:ap-southeast-2:ACCOUNT_ID:table/SiteFlowRelease",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "FINAL#*",
            "ABORT#*"
          ]
        },
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "ForAllValues:StringEquals": {
          "dynamodb:Attributes": [
            "pk",
            "manifestHash",
            "status"
          ]
        }
      },
      "Action": [
        "dynamodb:PutItem"
      ]
    }
  ]
}
