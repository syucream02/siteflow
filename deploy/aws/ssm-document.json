{
  "schemaVersion": "2.2",
  "description": "SiteFlow fixed release entry. Do not install without approval.",
  "parameters": {
    "ReleaseId": {
      "type": "String",
      "allowedPattern": "^deploy-[1-9][0-9]{0,19}-1$",
      "interpolationType": "ENV_VAR"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "fixedRelease",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "720",
        "runCommand": [
          "set -eu",
          "test -n \"${SSM_ReleaseId:-}\" || exit 1",
          "exec /usr/local/lib/siteflow/aws/start-release.sh \"$SSM_ReleaseId\""
        ]
      }
    }
  ]
}
