# 原則は除外し、ビルドに必要なものだけを許可する。
**
!Dockerfile
!.dockerignore
!.npmrc
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!eslint.config.mjs
!postcss.config.mjs
!components.json
!cloudflare-env.d.ts
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!hooks/
!hooks/**
!public/
!public/**
!vendor/
!vendor/**
!config/
!config/**
!scripts/
!scripts/**
!deploy/
!deploy/**
!tests/
!tests/**
!db/
!db/design/
!db/design/integrated.prisma
!examples/
!examples/mysql/
!examples/mysql/*.ts
!examples/mysql/*.mjs
!examples/mysql/*.json
# 許可ディレクトリ内にも適用する最終の拒否ルール。
**/node_modules
**/node_modules/**
**/generated
**/generated/**
**/.next
**/.next/**
**/work
**/work/**
**/.git
**/.git/**
**/.aws
**/.aws/**
**/.agents
**/.agents/**
**/.codex
**/.codex/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.log
**/*.tsbuildinfo
**/*.sql
# migration専用段階で使う履歴のみ許可する。
!db/design/migrations/
!db/design/migrations/migration_lock.toml
!db/design/migrations/*/
!db/design/migrations/*/migration.sql
